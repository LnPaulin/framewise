[Desktop Entry]
Type=Application
Name=Framewise
GenericName=Screen Recorder and Screenshots
Comment=Record the screen, take and mark up screenshots, copy text, clipboard history
Keywords=record;screencast;screenshot;capture;ocr;text;clipboard;history;camera;color;picker;eyedropper;dictation;speech;voice;draw;annotate;pen;spotlight;compress;shrink;video;phone;send;share;qr;
Exec=framewise %F
Icon=com.gitcotech.Framewise
Terminal=false
Categories=AudioVideo;Video;Recorder;Graphics;Utility;
StartupNotify=true
DBusActivatable=true
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/3gpp;video/x-m4v;
Actions=record;screenshot;text;color;dictate;draw;fit;send;clipboard;camera;preferences;

[Desktop Action record]
Name=Record Screen
Exec=framewise record

[Desktop Action screenshot]
Name=Take a Screenshot
Exec=framewise screenshot

[Desktop Action text]
Name=Capture Text
Exec=framewise text

[Desktop Action color]
Name=Pick a Color
Exec=framewise color

[Desktop Action dictate]
Name=Dictate
Exec=framewise dictate

[Desktop Action draw]
Name=Draw on Screen
Exec=framewise draw

[Desktop Action fit]
Name=Make a Video Fit
Exec=framewise fit

[Desktop Action send]
Name=Send to Phone
Exec=framewise send

[Desktop Action clipboard]
Name=Clipboard History
Exec=framewise clipboard

[Desktop Action camera]
Name=Toggle Camera
Exec=framewise camera

[Desktop Action preferences]
Name=Settings
Exec=framewise settings
