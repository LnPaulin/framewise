[Desktop Entry]
Type=Application
Name=Framewise
GenericName=Screen Recorder and Screenshots
Comment=Record the screen, take and mark up screenshots, copy text, clipboard history
Keywords=record;screencast;screenshot;capture;ocr;text;clipboard;history;camera;color;picker;eyedropper;dictation;speech;voice;draw;annotate;pen;spotlight;
Exec=framewise
Icon=com.gitcotech.Framewise
Terminal=false
Categories=AudioVideo;Video;Recorder;Graphics;Utility;
StartupNotify=true
DBusActivatable=true
Actions=record;screenshot;text;color;dictate;draw;clipboard;camera;preferences;

[Desktop Action record]
Name=Record Screen
Exec=framewise record

[Desktop Action screenshot]
Name=Take a Screenshot
Exec=framewise screenshot

[Desktop Action text]
